{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": { "@shared/*": ["../supabase/functions/_shared/*"] }
  },
  "include": ["src", "../supabase/functions/_shared/rules.ts", "../supabase/functions/_shared/url.ts", "../supabase/functions/_shared/types.ts"]
}
